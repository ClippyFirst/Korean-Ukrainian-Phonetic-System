{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClippyFirst Extended IPA result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "source",
    "layers",
    "variants",
    "boundaries",
    "trace",
    "target_adapter",
    "pronunciation_status",
    "context",
    "acoustic_annotations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "mode": {
      "const": "extended-ipa"
    },
    "source": {
      "type": "object",
      "required": [
        "text",
        "offset_unit"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "offset_unit": {
          "const": "unicode-code-points"
        }
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "object",
      "required": [
        "phonemic",
        "broad",
        "narrow"
      ],
      "properties": {
        "phonemic": {
          "$ref": "#/$defs/layer"
        },
        "broad": {
          "$ref": "#/$defs/layer"
        },
        "narrow": {
          "$ref": "#/$defs/layer"
        }
      },
      "additionalProperties": false
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "layer",
          "ipa",
          "evidence_status",
          "evidence_refs",
          "environment",
          "uncertainty",
          "selected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": [
              "phonemic",
              "broad",
              "narrow"
            ]
          },
          "ipa": {
            "type": "string"
          },
          "evidence_status": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "environment": {
            "type": [
              "string",
              "null"
            ]
          },
          "uncertainty": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_span": {
            "$ref": "#/$defs/span"
          },
          "selected": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "offset",
          "kind"
        ],
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "syllable",
              "word",
              "phrase"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "layer",
          "source_span",
          "source",
          "rule_ids",
          "environment",
          "evidence_refs",
          "evidence_status",
          "status"
        ],
        "properties": {
          "source_span": {
            "$ref": "#/$defs/span"
          },
          "source": {
            "type": "string"
          },
          "surface": {
            "type": [
              "string",
              "null"
            ]
          },
          "ipa": {
            "type": [
              "string",
              "null"
            ]
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "environment": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_status": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "layer": {
            "enum": [
              "phonemic",
              "broad",
              "narrow"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "target_adapter": {
      "type": "object",
      "required": [
        "status",
        "input_layer",
        "profile_id"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "input_layer": {
          "enum": [
            "phonemic",
            "broad",
            "narrow",
            "none"
          ]
        },
        "profile_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "pronunciation_status": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "required": [
        "speaker_id",
        "dialect",
        "age_group",
        "speech_style",
        "speech_rate_syllables_per_second",
        "focus",
        "prosodic_position",
        "recording_conditions"
      ],
      "properties": {
        "speaker_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "dialect": {
          "type": [
            "string",
            "null"
          ]
        },
        "age_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "speech_style": {
          "type": [
            "string",
            "null"
          ]
        },
        "speech_rate_syllables_per_second": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "focus": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "prosodic_position": {
          "type": [
            "string",
            "null"
          ]
        },
        "recording_conditions": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "acoustic_annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "feature",
          "value",
          "unit",
          "source_span",
          "measurement_method",
          "evidence_refs",
          "status"
        ],
        "properties": {
          "feature": {
            "enum": [
              "vot",
              "burst_duration",
              "closure_duration",
              "closure_voicing_ratio",
              "post_stop_f0",
              "h1_h2",
              "h1_a1",
              "cpp",
              "spectral_centroid",
              "f1",
              "f2",
              "f0"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "source_span": {
            "$ref": "#/$defs/span"
          },
          "measurement_method": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "measured",
              "derived",
              "unavailable",
              "hypothesis"
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "measured"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "measurement_method": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_refs": {
                  "type": "array",
                  "minItems": 1
                },
                "source_span": {
                  "type": "object"
                }
              },
              "required": [
                "measurement_method",
                "evidence_refs",
                "source_span"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "span": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "layer": {
      "type": "object",
      "required": [
        "ipa",
        "profile_id",
        "profile_version",
        "level",
        "status",
        "evidence_status",
        "target_compatible",
        "segments"
      ],
      "properties": {
        "ipa": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "level": {
          "enum": [
            "phonemic",
            "broad",
            "narrow"
          ]
        },
        "status": {
          "type": "string"
        },
        "evidence_status": {
          "type": "string"
        },
        "target_compatible": {
          "type": "boolean"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment_token"
          }
        }
      },
      "additionalProperties": false
    },
    "segment_token": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "ipa",
        "ipa_span"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "segment",
            "boundary",
            "unknown"
          ]
        },
        "ipa": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "modifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "features": {
          "type": "object",
          "additionalProperties": true
        },
        "ipa_span": {
          "$ref": "#/$defs/non_null_span"
        },
        "source_span": {
          "$ref": "#/$defs/span"
        },
        "source_alignment": {
          "enum": [
            "syllable-span",
            "unavailable"
          ]
        },
        "provenance": {
          "type": "object",
          "properties": {
            "rule_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_status": {
              "type": "string"
            },
            "environment": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "rule_ids",
            "evidence_refs",
            "evidence_status",
            "environment"
          ],
          "additionalProperties": false
        },
        "boundary": {
          "enum": [
            "word",
            "syllable",
            "separator"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "non_null_span": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
