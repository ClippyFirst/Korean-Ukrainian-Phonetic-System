{
  "name": "korean-ukrainian-phonetic-system-web",
  "private": true,
  "version": "1.0.0",
  "description": "Korean to Ukrainian transliteration service with IPA-mediated and Revised Romanization-mediated output routes.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "vite build",
    "check:release": "npm test && npm run build",
    "crawl:nikl": "node scripts/nikl-norm-crawler.mjs",
    "import:nikl-evidence": "node scripts/nikl-evidence-import.mjs",
    "template:nikl-evidence": "node scripts/nikl-evidence-template.mjs",
    "import:nikl-pdf": "node scripts/nikl-pdf-import.mjs",
    "template:nikl-pdf": "node scripts/nikl-pdf-template.mjs",
    "audit:source-register": "node scripts/audit-source-register.mjs",
    "ipa:review-packet": "node scripts/build-ipa-review-packet.mjs",
    "ipa:validate-submission": "node scripts/validate-ipa-review-submission.mjs",
    "audit:nikl-test-index": "node scripts/audit-nikl-article-test-index.mjs",
    "generate:ipa-target-data": "python scripts/generate_ipa_target_data.py",
    "check:ipa-target-data": "python scripts/generate_ipa_target_data.py --check",
    "ipa:compare-review-pair": "node scripts/compare-ipa-review-pair.mjs",
    "predev": "node scripts/prepare-hanja-dictionary.mjs",
    "prebuild": "node scripts/prepare-hanja-dictionary.mjs",
    "prepare:hanja-dictionary": "node scripts/prepare-hanja-dictionary.mjs"
  },
  "devDependencies": {
    "vite": "8.3.1"
  }
}
