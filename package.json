{
  "name": "korean-ukrainian-phonetic-system-web",
  "private": true,
  "version": "1.0.0",
  "description": "Korean to Ukrainian practical transcription service built on the research model.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "vite build",
    "check:release": "npm test && npm run build",
    "crawl:nikl": "node scripts/nikl-norm-crawler.mjs",
    "import:nikl-evidence": "node scripts/nikl-evidence-import.mjs",
    "template:nikl-evidence": "node scripts/nikl-evidence-template.mjs",
    "import:nikl-pdf": "node scripts/nikl-pdf-import.mjs",
    "template:nikl-pdf": "node scripts/nikl-pdf-template.mjs"
  },
  "devDependencies": {
    "vite": "8.3.1"
  }
}
